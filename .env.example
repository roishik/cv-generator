# ─────────────────────────────────────────────────────────────────
# cv-generator — Environment Variables
# Copy this file to .env and fill in values.
# The minimal set to run locally with zero external accounts:
#   NEXTAUTH_URL, AUTH_SECRET, AUTH_DEV_LOGIN=true,
#   DATABASE_URL, APP_DATABASE_URL (optional),
#   STORAGE_SIGNING_SECRET, MASTER_KEY_SECRET, AI_PROVIDER=mock
# ─────────────────────────────────────────────────────────────────

# ── Node ──────────────────────────────────────────────────────────
NODE_ENV=development

# ── App ───────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Auth.js Google OAuth (optional locally when AUTH_DEV_LOGIN=true)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enable dev-login shim (Credentials provider for local dev; disabled in prod)
AUTH_DEV_LOGIN=true
# Optional comma-separated email allowlist for private beta
AUTH_ALLOWED_EMAILS=

# ── Database (Docker Compose Postgres 16) ─────────────────────────
# docker-compose maps host port 5433 -> container 5432 (avoids colliding
# with any other local Postgres on 5432). Adjust if you change the mapping.
# Owner/migration role (privileged; runs migrations, owns objects)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cvgen
# RLS-enforced application role (non-superuser, NO BYPASSRLS)
APP_DATABASE_URL=postgresql://app_user:app_pw@localhost:5433/cvgen

# ── File storage (local filesystem adapter) ───────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Generate with: openssl rand -base64 32
STORAGE_SIGNING_SECRET=

# (Future Supabase adapter — unused locally)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET_UPLOADS=uploads
# SUPABASE_STORAGE_BUCKET_ARTIFACTS=artifacts

# ── Encryption ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Wraps per-user AI provider keys (AES-256-GCM)
MASTER_KEY_SECRET=

# ── AI (BYOK — real keys are per-user in DB; these are dev/CI only)
# mock | anthropic | openai | google
AI_PROVIDER=mock
# Optional override key for the selected provider in dev
# DEV_AI_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
OPENAI_DEFAULT_MODEL=gpt-4.1
GOOGLE_DEFAULT_MODEL=gemini-2.5-pro

# ── PDF ───────────────────────────────────────────────────────────
# Optional explicit Chromium path; else Playwright-managed
# PLAYWRIGHT_CHROMIUM=
PDF_MAX_CONCURRENCY=3

# ── Rate limiting ─────────────────────────────────────────────────
RATELIMIT_LLM_PER_HOUR=10
RATELIMIT_UPLOAD_PER_HOUR=20
