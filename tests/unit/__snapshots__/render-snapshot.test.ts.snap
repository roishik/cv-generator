// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`rendered HTML snapshots > clean body markup 1`] = `"<header class="cv-header" data-section="header"><h1 class="name" data-field="name">Dana Whitfield</h1><div class="title" data-field="title">Senior Product Manager · AI Platforms</div><div class="contact"><span data-field="location">San Francisco, CA</span>·<span data-field="phone">+1 415 555 0142</span>·<span data-field="email">dana@example.com</span>·<span data-field="linkedin">linkedin.com/in/danawhitfield</span>·<a class="cv-website" data-field="website">danawhitfield.dev</a></div><p class="summary" data-field="summary">Product leader with 9 years building 0→1 ML-powered products. Shipped a developer platform to 40k MAU and led a 12-person cross-functional team.</p></header><section><h2 class="section-title">Professional Experience</h2><div class="entry" data-exp-index="0"><div class="entry-row"><div class="left"><span class="org" data-field="company">Northstar AI</span><span class="sep">|</span><span class="role" data-field="title">Senior Product Manager</span></div><div class="right" data-field="period">2021 — Present</div></div><ul class="bullets" data-field="bullets"><li class="exp-bullet">Led the 0→1 launch of an LLM developer platform, growing to 40,000 monthly active developers in 14 months.</li><li class="exp-bullet">Defined the API roadmap with eng leadership; cut time-to-first-call from 30 min to under 5.</li><li class="exp-bullet">Ran weekly experiments that lifted activation 22% and retention 11%.</li></ul></div><div class="entry" data-exp-index="1"><div class="entry-row"><div class="left"><span class="org" data-field="company">Mapline</span><span class="sep">|</span><span class="role" data-field="title">Product Manager</span></div><div class="right" data-field="period">2017 — 2021</div></div><ul class="bullets" data-field="bullets"><li class="exp-bullet">Owned the geospatial analytics suite used by 300+ enterprise customers.</li><li class="exp-bullet">Shipped a self-serve onboarding flow that reduced sales-assist tickets 35%.</li></ul></div></section><section><h2 class="section-title">Education</h2><div class="entry" data-edu-index="0"><div class="entry-row"><div class="left"><span class="org" data-field="institution">University of Washington</span><span class="sep">|</span><span class="role" data-field="degree">B.S. Computer Science</span></div><div class="right" data-field="period">2012 — 2016</div></div><div class="edu-note" data-field="note">Minor in Statistics</div></div></section><section><h2 class="section-title">Skills &amp; Languages</h2><div class="skills-line"><span class="label">Professional:</span> <div class="skills-inline" data-section="skills" data-field="professional"><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="0">Product Strategy</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="1">ML/AI Products</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="2">Roadmapping</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="3">SQL</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="4">A/B Testing</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="5">Developer Platforms</span></div></div></div><div class="skills-line"><span class="label">Strengths:</span> <div class="skills-inline" data-section="skills" data-field="soft"><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="0">Cross-functional leadership</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="1">Stakeholder alignment</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="2">Mentoring</span></div></div></div><div class="languages-line"><span class="label">Languages:</span> English (Native), Spanish (Professional).</div></section>"`;

exports[`rendered HTML snapshots > sidebar body markup 1`] = `"<div class="cv-page"><aside class="sidebar"><div class="sidebar-photo"><div class="photo-circle" data-field="photo"><span class="photo-monogram">DW</span></div></div><div class="sidebar-section" data-section="contact"><div class="sidebar-section-header" data-field="sectionTitle">Contact</div><div class="contact-item"><svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg><span class="contact-text" data-field="email">dana@example.com</span></div><div class="contact-item"><svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.22 6.22l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><span class="contact-text" data-field="phone">+1 415 555 0142</span></div><div class="contact-item"><svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg><span class="contact-text" data-field="location">San Francisco, CA</span></div><div class="contact-item"><svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg><span class="contact-text" data-field="linkedin">linkedin.com/in/danawhitfield</span></div></div><div class="sidebar-divider"></div><div class="sidebar-section" data-section="skills"><div class="sidebar-section-header" data-field="sectionTitle">Professional Skills</div><div data-field="professional"><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="0">Product Strategy</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="1">ML/AI Products</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="2">Roadmapping</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="3">SQL</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="4">A/B Testing</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="5">Developer Platforms</span></div></div></div><div class="sidebar-divider"></div><div class="sidebar-section" data-section="soft-skills"><div class="sidebar-section-header" data-field="sectionTitle">Soft Skills</div><div data-field="soft"><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="0">Cross-functional leadership</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="1">Stakeholder alignment</span></div><div class="skill-item"><div class="skill-bullet"></div><span class="skill-text" data-skill-index="2">Mentoring</span></div></div></div><div class="sidebar-divider"></div><div class="sidebar-section" data-section="leadership" style="flex:1"><div class="sidebar-section-header" data-field="sectionTitle">Leadership &amp; Impact</div><div class="project-item" data-leadership-index="0"><div class="project-name" data-field="name">PM Mentorship Circle</div><div class="project-desc" data-field="description">Founded and ran a 30-person mentorship program for early-career PMs. <a href="https://pmcircle.org">pmcircle.org</a></div></div></div></aside><main class="main-content"><header class="cv-header" data-section="header"><h1 class="cv-name" data-field="name">Dana Whitfield</h1><div class="cv-title" data-field="title">Senior Product Manager · AI Platforms</div><a class="cv-website" data-field="website">danawhitfield.dev</a><p class="cv-summary" data-field="summary">Product leader with 9 years building 0→1 ML-powered products. Shipped a developer platform to 40k MAU and led a 12-person cross-functional team.</p></header><div class="main-divider"></div><section class="experience-section" data-section="experience"><div class="main-section-header" data-field="sectionTitle">Experience</div><div class="experience-list"><div class="experience-entry" data-exp-index="0"><div class="exp-company-period"><span data-field="company">Northstar AI</span>  |  <span data-field="period">2021 — Present</span></div><div class="exp-job-title" data-field="title">Senior Product Manager</div><ul class="exp-bullets" data-field="bullets"><li class="exp-bullet">Led the 0→1 launch of an LLM developer platform, growing to 40,000 monthly active developers in 14 months.</li><li class="exp-bullet">Defined the API roadmap with eng leadership; cut time-to-first-call from 30 min to under 5.</li><li class="exp-bullet">Ran weekly experiments that lifted activation 22% and retention 11%.</li></ul></div><div class="experience-entry" data-exp-index="1"><div class="exp-company-period"><span data-field="company">Mapline</span>  |  <span data-field="period">2017 — 2021</span></div><div class="exp-job-title" data-field="title">Product Manager</div><ul class="exp-bullets" data-field="bullets"><li class="exp-bullet">Owned the geospatial analytics suite used by 300+ enterprise customers.</li><li class="exp-bullet">Shipped a self-serve onboarding flow that reduced sales-assist tickets 35%.</li></ul></div></div></section><div class="main-divider"></div><section class="education-section" data-section="education"><div class="main-section-header" data-field="sectionTitle">Education</div><div class="education-entry" data-edu-index="0"><div class="edu-institution" data-field="institution">University of Washington</div><div class="edu-period" data-field="period">2012 — 2016</div><div class="edu-degree" data-field="degree">B.S. Computer Science</div><div class="edu-note" data-field="note">Minor in Statistics</div></div></section><div class="references-line">References available upon request</div></main></div>"`;
